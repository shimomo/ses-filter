{
  "name": "ses-filter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "eval": "vitest run --config vitest.eval.config.ts eval/report.eval.ts",
    "eval:review": "vitest run --config vitest.eval.config.ts eval/review.eval.ts",
    "eval:cards": "vitest run --config vitest.eval.config.ts eval/cards.eval.ts",
    "eval:pick-green": "vitest run --config vitest.eval.config.ts eval/pick-green.eval.ts",
    "eval:holdout": "EVAL_SET=holdout vitest run --config vitest.eval.config.ts eval/report.eval.ts",
    "eval:holdout:review": "EVAL_SET=holdout vitest run --config vitest.eval.config.ts eval/review.eval.ts",
    "eval:holdout:cards": "EVAL_SET=holdout vitest run --config vitest.eval.config.ts eval/cards.eval.ts",
    "eval:holdout:pick-green": "EVAL_SET=holdout vitest run --config vitest.eval.config.ts eval/pick-green.eval.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  }
}
